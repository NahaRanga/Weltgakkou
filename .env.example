# Supabase (Project Settings > API Keys).
# Publishable/anon key dipakai untuk login; secret/service role key hanya di server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alamat website, dipakai di link email dan WhatsApp (tanpa garis miring di akhir).
SITE_URL=https://weltgakkou.com

# Nomor WhatsApp admin, format 62xxxxxxxxxx (tanpa + atau 0 di depan).
NEXT_PUBLIC_WA_NUMBER=

# Rekening tujuan transfer (tahap awal: rekening pribadi Nurdin).
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
# URL gambar QRIS statis (opsional), misalnya /qris.png bila filenya ditaruh di folder public.
NEXT_PUBLIC_QRIS_IMAGE_URL=

# Persentase fee referral (5-10). Default 10.
REFERRAL_PERCENT=10

# Email (opsional). Tanpa Resend, admin mengirim link login lewat WhatsApp dari halaman admin.
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM="Weltgakkou <noreply@weltgakkou.com>"
