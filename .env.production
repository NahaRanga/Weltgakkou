# Nilai publik yang ikut ditanam saat build production (bukan rahasia).
# Kosong: website di root weltgakko.com. Isi (misalnya /weltgakko) hanya bila dipasang di sub-path.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_WA_NUMBER=6288294034285
# Analytics iklan (opsional). Kosong = script tidak dimuat. Lihat docs/analytics.md.
NEXT_PUBLIC_META_PIXEL_ID=
