{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Dipasang di weltgakko.com (root, tanpa base path). Route panjimuhammad.com/weltgakko* dibiarkan supaya
  // alamat lama dialihkan ke weltgakko.com (lihat redirects() di next.config.ts).
  "workers_dev": false,
  "routes": [
    { "pattern": "weltgakko.com", "custom_domain": true },
    { "pattern": "www.weltgakko.com", "custom_domain": true },
    { "pattern": "panjimuhammad.com/weltgakko*", "zone_name": "panjimuhammad.com" }
  ],
  // Variabel biasa. Kunci Supabase dan rekening disimpan sebagai Secret di Cloudflare.
  "vars": { "SITE_URL": "https://weltgakko.com", "REFERRAL_PERCENT": "10", "EMAIL_VERIFICATION": "on" },
  "name": "weltgakkou",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "weltgakkou"
    }
  ],
  "observability": { "enabled": true }
}
